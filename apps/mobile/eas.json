{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_STATUS_INGEST_URL": "@EXPO_PUBLIC_STATUS_INGEST_URL",
        "EXPO_PUBLIC_STATUS_INGEST_KEY": "@EXPO_PUBLIC_STATUS_INGEST_KEY",
        "EXPO_PUBLIC_STATUS_ENVIRONMENT": "prod"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_STATUS_INGEST_URL": "@EXPO_PUBLIC_STATUS_INGEST_URL",
        "EXPO_PUBLIC_STATUS_INGEST_KEY": "@EXPO_PUBLIC_STATUS_INGEST_KEY",
        "EXPO_PUBLIC_STATUS_ENVIRONMENT": "prod"
      }
    },
    "production": {
      "autoIncrement": false,
      "env": {
        "NODE_OPTIONS": "--max-old-space-size=4096",
        "EXPO_PUBLIC_STATUS_INGEST_URL": "@EXPO_PUBLIC_STATUS_INGEST_URL",
        "EXPO_PUBLIC_STATUS_INGEST_KEY": "@EXPO_PUBLIC_STATUS_INGEST_KEY",
        "EXPO_PUBLIC_STATUS_ENVIRONMENT": "prod"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
