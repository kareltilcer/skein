# Status reporting configuration for ws-tilcer-status
# These variables are used for error/crash reporting to status.tilcer.cz

# For Expo development, use EXPO_PUBLIC_ prefix for client-side variables
# Required: The ingest endpoint URL for your site
EXPO_PUBLIC_STATUS_INGEST_URL=https://status.tilcer.cz/api/ingest/yarnlog

# Required: The ingest key for your site (shown once when creating the site in the dashboard)
EXPO_PUBLIC_STATUS_INGEST_KEY=ik_your_mobile_ingest_key_here

# Optional: Environment identifier (default: 'prod')
EXPO_PUBLIC_STATUS_ENVIRONMENT=dev

# Optional: Release identifier (default: 'mobile@unknown')
# This should match your app version for better tracking
EXPO_PUBLIC_STATUS_RELEASE=mobile@1.0.0

# Note: In production builds, these can also be configured in app.json extra section
# or in EAS build configuration for different environments.