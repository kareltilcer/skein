# Status reporting configuration for ws-tilcer-status
# These variables are used for error/crash reporting to status.tilcer.cz

# Required: The ingest endpoint URL for your site
VITE_STATUS_INGEST_URL=https://status.tilcer.cz/api/ingest/skein-web

# Required: The ingest key for your site (shown once when creating the site in the dashboard)
VITE_STATUS_INGEST_KEY=ik_your_public_browser_key_here

# Optional: Environment identifier (default: 'prod')
VITE_STATUS_ENVIRONMENT=prod

# Optional: Release identifier (default: 'web@unknown')
# This should match your app version for better tracking
VITE_STATUS_RELEASE=web@1.0.0